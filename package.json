{
  "name": "moi-uroki",
  "productName": "Мои уроки",
  "version": "1.3.0",
  "description": "Планер репетитора: расписание, записи уроков, учёт заработка",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-win.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "local.moi.uroki",
    "productName": "Мои уроки",
    "copyright": "Мои уроки",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "icons/**",
      "electron/**",
      "!**/*.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icons/icon.ico",
      "executableName": "MoiUroki",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "author": "Мои уроки",
  "homepage": "https://github.com/mrcreate163/english-teacher"
}