{
  "name": "moi-uroki",
  "productName": "Мои уроки",
  "version": "1.0.0",
  "description": "Планер репетитора: расписание, записи уроков, учёт заработка",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.moi.uroki",
    "productName": "Мои уроки",
    "files": ["index.html", "css/**", "js/**", "icons/**", "electron/**", "manifest.webmanifest"],
    "directories": { "output": "dist" },
    "win": { "icon": "icons/icon-512.png", "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "language": "1049" },
    "artifactName": "Moi-uroki-${version}-${target}.${ext}"
  }
}
